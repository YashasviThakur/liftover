diff --git a/shop/flags.py b/shop/flags.py
index d2a0c4a..e1e7f6d 100644
--- a/shop/flags.py
+++ b/shop/flags.py
@@ -1,16 +1,20 @@
-"""The shop's flag client: Unleash today. Liftover moves this to Flagsmith."""
+"""The shop's flag client: Flagsmith (migrated from Unleash and env vars by Liftover)."""
 import os
 
-from UnleashClient import UnleashClient
+from flagsmith import Flagsmith
+from flagsmith.models import DefaultFlag
 
-unleash = UnleashClient(
-    url=os.environ.get("UNLEASH_URL", "http://localhost:4242/api"),
-    app_name="demo-shop",
-    api_key=os.environ.get("UNLEASH_CLIENT_TOKEN", ""),  # the token picks the environment
+flagsmith = Flagsmith(
+    environment_key=os.environ.get("FLAGSMITH_ENVIRONMENT_KEY", ""),  # the key picks the environment
+    api_url=os.environ.get("FLAGSMITH_API_URL", "https://edge.api.flagsmith.com/api/v1/"),
+    # Unleash answered "off" for unknown flags; keep that (also covers Flagsmith being unreachable).
+    default_flag_handler=lambda name: DefaultFlag(enabled=False, value=None),
 )
-unleash.initialize_client()
 
 
-def context(user) -> dict:
-    return {"userId": user["id"], "properties": {
-        "plan": user.get("plan", "free"), "country": user.get("country", ""), "age": str(user.get("age", 0))}}
+def flags_for(user=None):
+    """Same attributes the Unleash context had, as Flagsmith traits."""
+    if user is None:
+        return flagsmith.get_environment_flags()
+    return flagsmith.get_identity_flags(user["id"], traits={
+        "plan": user.get("plan", "free"), "country": user.get("country", ""), "age": int(user.get("age", 0))})
